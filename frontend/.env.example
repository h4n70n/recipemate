# RecipeMate web client environment variables.
# Copy to `.env.local` and fill in. All vars are read at build time (Vite),
# so a rebuild is required after changing them.

# Base URL of the RecipeMate REST API, including the /v1 prefix.
# Local default (when unset): http://localhost:5000/v1
VITE_API_BASE_URL=http://localhost:5000/v1

# --- Amazon Cognito (Hosted UI / OAuth redirect) ---
# User pool id, e.g. us-east-1_abc123DEF
VITE_COGNITO_USER_POOL_ID=
# App client id (public SPA client, no secret)
VITE_COGNITO_CLIENT_ID=
# Hosted UI domain WITHOUT scheme, e.g. recipemate.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# AWS region of the user pool, e.g. us-east-1
VITE_COGNITO_REGION=us-east-1
# OAuth redirect URLs — must be registered as allowed callback/sign-out URLs
# on the Cognito app client. Default to the app origin when unset.
VITE_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_REDIRECT_SIGN_OUT=http://localhost:5173/
