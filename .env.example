# RecipeMate — Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Environment reference:
#   local   — Docker Compose on your machine (uses LocalStack for AWS)
#   staging — AWS staging environment
#   prod    — AWS production environment

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------

# Controls which config class is loaded (local | staging | prod)
FLASK_ENV=local

# Secret key used for session signing and CSRF protection.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker Compose: postgresql+psycopg2://recipemate:recipemate@db:5432/recipemate
# AWS RDS:              postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+psycopg2://recipemate:recipemate@db:5432/recipemate

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis connection string used for caching and temporary metadata storage.
# Local Docker Compose: redis://redis:6379/0
# AWS ElastiCache:      redis://<host>:6379/0
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# AWS — General
# ---------------------------------------------------------------------------

# AWS region for all services.
AWS_REGION=us-east-2

# AWS IAM credentials.
# For local development these are set to "test" so LocalStack accepts them.
# For staging/prod, use real IAM credentials (or an instance role — do not set these).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Override the AWS endpoint URL to point at LocalStack in local development.
# Remove or leave empty when targeting real AWS.
AWS_ENDPOINT_URL=http://localstack:4566

# ---------------------------------------------------------------------------
# AWS — S3
# ---------------------------------------------------------------------------

# S3 bucket name for recipe and cook-log images.
S3_BUCKET=recipemate-images

# ---------------------------------------------------------------------------
# AWS — SQS
# ---------------------------------------------------------------------------

# URL of the SQS queue that receives recipe extraction jobs.
# Local (LocalStack): http://localstack:4566/000000000000/recipemate-extraction
# AWS:               https://sqs.<region>.amazonaws.com/<account-id>/recipemate-extraction
SQS_EXTRACTION_QUEUE_URL=http://localstack:4566/000000000000/recipemate-extraction

# ---------------------------------------------------------------------------
# AWS — SNS
# ---------------------------------------------------------------------------

# ARN of the SNS topic used to fan out extraction-complete push notifications.
# Local (LocalStack): arn:aws:sns:us-east-1:000000000000:recipemate-notifications
# AWS:               arn:aws:sns:<region>:<account-id>:recipemate-notifications
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:recipemate-notifications

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------

# API key for GPT-4o vision-based recipe extraction and natural-language search.
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# AWS Cognito — Authentication
# ---------------------------------------------------------------------------

# Cognito User Pool ID (format: <region>_<id>, e.g. us-east-2_AbCdEfGhI)
COGNITO_USER_POOL_ID=us-east-2_YourPoolId

# Cognito App Client ID for this application.
COGNITO_CLIENT_ID=your-cognito-app-client-id

# AWS region where the Cognito User Pool is deployed.
# Usually the same as AWS_REGION but can differ.
COGNITO_REGION=us-east-2
